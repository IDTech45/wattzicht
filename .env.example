# Wattzicht – omgevingsvariabelen voor docker-compose.
# Kopieer naar .env.production (of draai scripts/generate-secrets.sh) en vul de geheimen in.
# Commit .env.production NOOIT.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=wattzicht
POSTGRES_USER=wattzicht
POSTGRES_PASSWORD=vervang-mij

# --- Geheimen (minimaal 32 tekens; generate-secrets.sh maakt ze) --------------
JWT_SECRET=vervang-mij-met-minimaal-32-willekeurige-tekens
WZ_PROTECTION_KEY=vervang-mij-base64-32-bytes

# --- CORS (alleen nodig voor losse clients; de website gaat via nginx /api) ----
# Zet hier het domein van de website (uit Dokploy → Domains), bijv. https://wattzicht-xxxx.traefik.me
CORS_ORIGIN_0=https://wattzicht.nl
CORS_ORIGIN_1=https://www.wattzicht.nl

# --- Seed / opties -----------------------------------------------------------
# Laat je een wachtwoord leeg, dan wordt dat account niet aangemaakt (geen wachtwoord uit de broncode).
SEED_ENABLED=true
# Leeg = admin@wattzicht.nl.
SEED_ADMIN_ACCOUNT=
SEED_ADMIN_PASSWORD=
SEED_INSTALLER_PASSWORD=
# Demo-woning met gesimuleerde data: alleen aanzetten om te demonstreren, nooit op een echte omgeving.
SEED_DEMO=false
SEED_DEMO_PASSWORD=
SWAGGER_ENABLED=false

# --- Enphase (developer-v4.enphase.com) --------------------------------------
# Hetzelfde developer-account als LaadCash mag, maar dan delen beide apps het quotum van
# 1.000 verzoeken per maand van het gratis plan "Watt". Daarom leest de poller Enphase per uur.
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
ENPHASE_API_KEY=

# --- Plus en de stores (zie docs/STORES.md) ----------------------------------
# Plus gaat open op 1 januari 2027. Tot die tijd false; de abonnementen lopen wel al mee.
PLUS_ENABLED=false
STORE_APPLE_KEY_ID=
STORE_APPLE_ISSUER_ID=
STORE_APPLE_BUNDLE_ID=nl.wattzicht.app
STORE_APPLE_PRIVATE_KEY_PEM=
STORE_GOOGLE_PACKAGE_NAME=nl.wattzicht.app
