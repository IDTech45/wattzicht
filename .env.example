# Wattzicht – omgevingsvariabelen voor docker-compose.
# Kopieer naar .env.production (of draai scripts/generate-secrets.sh) en vul de geheimen in.
# Commit .env.production NOOIT.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=wattzicht
POSTGRES_USER=wattzicht
POSTGRES_PASSWORD=vervang-mij

# --- Geheimen (minimaal 32 tekens; generate-secrets.sh maakt ze) --------------
JWT_SECRET=vervang-mij-met-minimaal-32-willekeurige-tekens
WZ_PROTECTION_KEY=vervang-mij-base64-32-bytes

# --- CORS (alleen nodig voor losse clients; de website gaat via nginx /api) ----
# Zet hier het domein van de website (uit Dokploy → Domains), bijv. https://wattzicht-xxxx.traefik.me
CORS_ORIGIN_0=https://wattzicht.nl
CORS_ORIGIN_1=https://www.wattzicht.nl

# --- Seed / opties -----------------------------------------------------------
SEED_ENABLED=true
SEED_INSTALLER_PASSWORD=
SEED_DEMO_PASSWORD=
SWAGGER_ENABLED=false
