<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Wattzicht.App.Services"
             xmlns:vm="clr-namespace:Wattzicht.App.ViewModels"
             xmlns:views="clr-namespace:Wattzicht.App.Views"
             x:Class="Wattzicht.App.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{t:Ts home.home}">

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,32" Spacing="12">

                    <!-- Kop met logo van de installateur (white-label) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <!-- Merk van de app: Wattzicht (de installateur staat rechts) -->
                            <HorizontalStackLayout Spacing="8" Margin="0,0,0,6" SemanticProperties.Description="Wattzicht">
                                <Image Source="logo.png" HeightRequest="28" WidthRequest="28" VerticalOptions="Center" />
                                <Label VerticalOptions="Center" FontSize="18" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="watt" TextColor="{AppThemeBinding Light={StaticResource TextBody}, Dark={StaticResource TextBodyDark}}" />
                                            <Span Text="zicht" TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource Accent500}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                            <Label Text="{Binding UpdatedAtText}" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <!--
                            Jouw installateur: alleen de naam. Wattzicht blijft het merk van de app, en een
                            logo van de installateur ernaast leest als een tweede merk op hetzelfde scherm.
                        -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End"
                                             IsVisible="{Binding InstallerName, Converter={StaticResource IsNotNullOrEmpty}}">
                            <Label Text="{t:T home.jouw-installateur}" Style="{StaticResource StatCaption}" HorizontalTextAlignment="End" />
                            <Label Text="{Binding InstallerName}" Style="{StaticResource CardTitle}" FontSize="14"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Foutmelding -->
                    <Border Style="{StaticResource DangerCard}" IsVisible="{Binding HasError}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ErrorMessage}" />
                            <Button Text="{t:T home.opnieuw-proberen}" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lege staat -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowEmptyState}" Padding="24">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Image Source="logo.png" HeightRequest="72" WidthRequest="72" Opacity="0.9" />
                            <Label Text="{t:T home.koppel-je-eerste-apparaat}" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" Margin="0" />
                            <Label Text="{t:T home.verbind-je-omvormer-thuisbatterij-of}"
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" HorizontalTextAlignment="Center" />
                            <Button Text="{t:T home.apparaat-koppelen}" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectDeviceCommand}" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Inhoud -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowContent}">

                        <!-- Alerts -->
                        <Border Style="{StaticResource DangerCard}" IsVisible="{Binding HasAlerts}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAlertsCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                                <Ellipse Grid.Column="0" WidthRequest="12" HeightRequest="12" Fill="{StaticResource ErrorDot}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding AlertsSummary}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{t:T home.een-apparaat-levert-geen-data}" Style="{StaticResource SubtitleLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="24" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" />
                            </Grid>
                        </Border>

                        <!-- Overschot: nu zelf gebruiken in plaats van terugleveren -->
                        <!-- Twee dingen waar de app zonder niet goed werkt en die je nergens
                             vanzelf tegenkomt. Verdwijnt zodra ze er staan. -->
                        <Border Style="{StaticResource Card}" IsVisible="{Binding ToonAfmaken}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{t:T afmaken.titel}" Style="{StaticResource CardTitle}" />
                                <Label Text="{t:T afmaken.plaats}" Style="{StaticResource SubtitleLabel}"
                                       FontSize="14" IsVisible="{Binding PlaatsOntbreekt}" />
                                <Label Text="{t:T afmaken.tarief}" Style="{StaticResource SubtitleLabel}"
                                       FontSize="14" IsVisible="{Binding TariefOntbreekt}" />
                                <Button Text="{t:T afmaken.knop}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding AfmakenCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasSurplus}" Stroke="{StaticResource EnergySolar}" StrokeThickness="2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAdviceCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding SurplusText}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{t:T home.gebruik-het-zelf-zet-nu}" Style="{StaticResource SubtitleLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="24" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" />
                            </Grid>
                        </Border>

                        <!--
                            De tip van vandaag. Staat op het scherm dat iedereen opent, want wie niet op
                            "Sturen" klikt zag anders nooit een tip. Een kaart en geen popup: bij elke
                            opstart iets moeten wegklikken is precies waarom mensen een app gaan mijden.
                        -->
                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasDayTip}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningBg}, Dark={StaticResource WarningBgDark}}"
                                Stroke="{StaticResource EnergySolar}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding DayTipHeadline}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding DayTipBody}" Style="{StaticResource SubtitleLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="24" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAdviceCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!--
                            Het weer. Staat boven de energiecijfers en niet onderaan: alles op dit
                            scherm gaat over zon, en zonder het weer ernaast kan niemand zien of een
                            matige dag aan de panelen lag of aan de bewolking. Geen plaats bij de
                            woning betekent geen verwachting, en dan blijft de kaart weg.
                        -->
                        <Border Style="{StaticResource Card}" IsVisible="{Binding HeeftWeer}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <GraphicsView x:Name="WeerVandaagView" Grid.Column="0"
                                                      Drawable="{Binding WeerVandaagIcoon}"
                                                      WidthRequest="36" HeightRequest="36"
                                                      VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{t:T weer.vandaag}" Style="{StaticResource StatCaption}" />
                                            <Label Text="{Binding WeerVandaagTemp}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding WeerVandaagTekst}" Style="{StaticResource StatCaption}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                          IsVisible="{Binding HeeftWeerMorgen}">
                                        <GraphicsView x:Name="WeerMorgenView" Grid.Column="0"
                                                      Drawable="{Binding WeerMorgenIcoon}"
                                                      WidthRequest="36" HeightRequest="36"
                                                      VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{t:T weer.morgen}" Style="{StaticResource StatCaption}" />
                                            <Label Text="{Binding WeerMorgenTemp}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding WeerMorgenTekst}" Style="{StaticResource StatCaption}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                                <Label Text="{Binding WeerVandaagExtra}" Style="{StaticResource StatCaption}" />
                                <Label Text="{Binding ZonMorgenTekst}" Style="{StaticResource SubtitleLabel}"
                                       FontSize="14" IsVisible="{Binding HeeftZonMorgen}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Energiestroom -->
                        <Label Text="{Binding StroomTitel}" Style="{StaticResource SectionTitle}" />
                        <views:EnergyFlowView Snapshot="{Binding Live}"
                                              PvTodayKwh="{Binding PvTodayKwh}"
                                              PvPeakKw="{Binding PvPeakKw}"
                                              ZonCommand="{Binding OpenPanelenCommand}" />

                        <!--
                            Meten we het huis en het net niet, dan staat er bij die twee "Niet
                            gemeten" en legt deze kaart uit waarom. Zonder deze kaart is "Niet
                            gemeten" een mededeling zonder uitweg.
                        -->
                        <Border Style="{StaticResource Card}" IsVisible="{Binding ToonNietGemeten}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{t:T meten.titel}" Style="{StaticResource CardTitle}" />
                                <Label Text="{t:T meten.uitleg}" Style="{StaticResource SubtitleLabel}" FontSize="14" />
                                <Button Text="{t:T meten.knop}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ConnectDeviceCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--
                            De uitnodiging. Staat hier en niet bovenaan: precies op de plek waar de
                            tegel zou staan die er niet is. Eén kaart voor beide apparaten, en hij
                            verdwijnt zodra ze er zijn.
                        -->
                        <Border Style="{StaticResource Card}" IsVisible="{Binding ToonKoppelUitnodiging}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{t:T koppelen.meer-titel}" Style="{StaticResource CardTitle}" />
                                <Label Text="{t:T koppelen.batterij-regel}" Style="{StaticResource SubtitleLabel}"
                                       FontSize="14" IsVisible="{Binding MistBatterij}" />
                                <Label Text="{t:T koppelen.laadpaal-regel}" Style="{StaticResource SubtitleLabel}"
                                       FontSize="14" IsVisible="{Binding MistLaadpaal}" />
                                <Button Text="{t:T koppelen.meer-knop}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ConnectDeviceCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--
                            Stat-tiles. Drie getallen naast elkaar op een telefoonbreedte, en dat is
                            krap: alle drie dus dezelfde maat, geen meeschalen met de systeemletter
                            en geen afbreken. "8.036 kWh" werd eerder "8.036 k...", en dat gold net
                            zo goed voor "€ 1.234,56" bij de eerste tegel; die had alleen nog nooit
                            zo'n dag gehad.
                        -->
                        <Label Text="{t:T home.vandaag}" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{t:T home.bespaard}" Style="{StaticResource StatCaption}" />
                                    <Label Text="{Binding SavedTodayText}" Style="{StaticResource StatValue}"
                                           FontSize="18" FontAutoScalingEnabled="False"
                                           LineBreakMode="NoWrap" MaxLines="1"
                                           TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{t:T home.zelfverbruik}" Style="{StaticResource StatCaption}" />
                                    <Label Text="{Binding SelfUsePercentText}" Style="{StaticResource StatValue}"
                                           FontSize="18" FontAutoScalingEnabled="False"
                                           LineBreakMode="NoWrap" MaxLines="1"
                                           TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{t:T home.opgewekt}" Style="{StaticResource StatCaption}" />
                                    <Label Text="{Binding PvTodayText}" Style="{StaticResource StatValue}"
                                           FontSize="18" FontAutoScalingEnabled="False"
                                           LineBreakMode="NoWrap" MaxLines="1" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Deze maand -->
                        <Label Text="{t:T home.deze-maand}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{t:T home.bespaard}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding MonthSavedText}" Style="{StaticResource StatValue}" TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" />
                                </Grid>
                                <BoxView Style="{StaticResource DividerLine}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="{t:T home.opgewekt}" Style="{StaticResource StatCaption}" />
                                        <Label Text="{Binding MonthPvText}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="{t:T home.zelf-gebruikt}" Style="{StaticResource StatCaption}" />
                                        <Label Text="{Binding MonthSelfUseText}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="{t:T home.teruggeleverd}" Style="{StaticResource StatCaption}" />
                                        <Label Text="{Binding MonthExportText}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="{t:T home.geladen-auto}" Style="{StaticResource StatCaption}" />
                                        <Label Text="{Binding MonthChargedText}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PendingText}, Dark={StaticResource PendingTextDark}}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView Style="{StaticResource DividerLine}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{t:T home.dit-jaar-bespaard}" Style="{StaticResource SubtitleLabel}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding YearSavedText}" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Eerste keer laden -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding HasLoaded, Converter={StaticResource InvertedBool}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
