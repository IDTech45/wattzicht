<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wattzicht.App.ViewModels"
             x:Class="Wattzicht.App.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Instellingen">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="12">

            <Label Text="Instellingen" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding HouseholdName}" Style="{StaticResource SubtitleLabel}" IsVisible="{Binding HouseholdName, Converter={StaticResource IsNotNullOrEmpty}}" />

            <Border Style="{StaticResource DangerCard}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" />
            </Border>

            <!-- ===== Tarief ===== -->
            <Label Text="Weergave" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Donker thema" Style="{StaticResource CardTitle}" />
                        <Label Text="Uit zet de app op een lichte achtergrond" Style="{StaticResource SubtitleLabel}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding IsDonkerThema}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="Je energietarief" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Hiermee rekenen we uit wat je bespaart. Je vindt het tarief op je energiecontract."
                           Style="{StaticResource SubtitleLabel}" FontSize="14" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Dynamisch contract" Style="{StaticResource CardTitle}" />
                            <Label Text="Uurprijzen van de markt in plaats van een vast tarief" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsDynamic}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsDynamic, Converter={StaticResource InvertedBool}}">
                        <Label Text="Leveringstarief (€ per kWh)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding ImportTariff}" Keyboard="Numeric" Placeholder="0,30" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding ImportTariffError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasImportTariffError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsDynamic}">
                        <Label Text="Gemiddeld leveringstarief (€ per kWh)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding ImportTariff}" Keyboard="Numeric" Placeholder="0,25" />
                            </Grid>
                        </Border>
                        <Label Text="Bij dynamisch gebruiken we dit als schatting tot de uurprijzen worden gekoppeld." Style="{StaticResource StatCaption}" />
                        <Label Text="{Binding ImportTariffError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasImportTariffError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Terugleververgoeding (€ per kWh)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding ExportTariff}" Keyboard="Numeric" Placeholder="0,08" />
                            </Grid>
                        </Border>
                        <Label Text="Tot 31-12-2026 geldt saldering; dan telt teruglevering als je leveringstarief." Style="{StaticResource StatCaption}" />
                        <Label Text="{Binding ExportTariffError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasExportTariffError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Terugleverkosten (€ per kWh)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding FeedInCost}" Keyboard="Numeric" Placeholder="0,120" />
                            </Grid>
                        </Border>
                        <Label Text="Staat op je contract of jaarafrekening. Betaal je een vast bedrag per jaar (staffel)? Deel dat door je teruggeleverde kWh."
                               Style="{StaticResource StatCaption}" />
                        <Label Text="{Binding FeedInCostError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasFeedInCostError}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding TariffSavedText}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}"
                           IsVisible="{Binding TariffSavedText, Converter={StaticResource IsNotNullOrEmpty}}" />

                    <Grid>
                        <Button Text="Tarief opslaan" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTariffCommand}"
                                IsEnabled="{Binding IsSavingTariff, Converter={StaticResource InvertedBool}}" />
                        <ActivityIndicator IsRunning="{Binding IsSavingTariff}" IsVisible="{Binding IsSavingTariff}"
                                           Color="{StaticResource Navy900}" HorizontalOptions="End" Margin="0,0,16,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Installateur ===== -->
            <Label Text="Je installateur" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*" ColumnSpacing="12">
                        <!--
                            Alleen de naam en het telefoonnummer. Wattzicht blijft het merk van de app;
                            een logo van de installateur ernaast leest als een tweede merk.
                        -->
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Jouw installateur" Style="{StaticResource StatCaption}" />
                            <Label Text="{Binding InstallerName}" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding InstallerPhone}" Style="{StaticResource SubtitleLabel}" IsVisible="{Binding HasInstallerPhone}" />
                            <Label Text="Voor vragen over je installatie" Style="{StaticResource SubtitleLabel}" IsVisible="{Binding HasInstallerPhone, Converter={StaticResource InvertedBool}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Bel installateur" Style="{StaticResource SecondaryButton}" Command="{Binding CallInstallerCommand}" IsVisible="{Binding HasInstallerPhone}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Installateur mag meekijken" Style="{StaticResource CardTitle}" />
                            <Label Text="Dan ziet je installateur storingen en je opwek, en kan sneller helpen. Je kunt dit altijd uitzetten."
                                   Style="{StaticResource SubtitleLabel}" />
                            <Label Text="{Binding LastViewedText}" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding InstallerAccess}" VerticalOptions="Center"
                                SemanticProperties.Description="Installateur mag meekijken" />
                    </Grid>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Nog geen thuisbatterij? Sla je zonnestroom op en gebruik hem 's avonds zelf." FontSize="14" />
                    <Button Text="Vraag offerte voor thuisbatterij" Style="{StaticResource PrimaryButton}" Command="{Binding RequestQuoteCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== Meldingen ===== -->
            <Label Text="Meldingen" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Bij een storing" Style="{StaticResource CardTitle}" />
                            <Label Text="Als een apparaat geen data meer geeft of niets opwekt" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NotifyAlerts}" VerticalOptions="Center"
                                SemanticProperties.Description="Melding bij een storing" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Bij veel terugleveren" Style="{StaticResource CardTitle}" />
                            <Label Text="Tip om je stroom zelf te gebruiken. Hooguit eens per 3 uur, tussen 9 en 20 uur." Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NotifySurplus}" VerticalOptions="Center"
                                SemanticProperties.Description="Melding bij veel terugleveren" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Account ===== -->
            <Label Text="Account" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Button Text="Uitloggen" Style="{StaticResource SecondaryButton}"
                            TextColor="{AppThemeBinding Light={StaticResource ErrorDot}, Dark={StaticResource ErrorTextDark}}"
                            BorderColor="{AppThemeBinding Light={StaticResource ErrorDot}, Dark={StaticResource ErrorTextDark}}"
                            Command="{Binding LogoutCommand}" />
                    <Label Text="{Binding VersionText}" Style="{StaticResource StatCaption}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ApiText}" Style="{StaticResource StatCaption}" HorizontalTextAlignment="Center" Opacity="0.7" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
