<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Wattzicht.App.Services"
             xmlns:vm="clr-namespace:Wattzicht.App.ViewModels"
             x:Class="Wattzicht.App.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{t:Ts meer.instellingen}">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="12">

            <Label Text="{t:T meer.instellingen}" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding HouseholdName}" Style="{StaticResource SubtitleLabel}" IsVisible="{Binding HouseholdName, Converter={StaticResource IsNotNullOrEmpty}}" />

            <Border Style="{StaticResource DangerCard}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" />
            </Border>

            <!-- ===== Tarief ===== -->
            <Label Text="{t:T meer.weergave}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <!-- Het woord Aan of Uit staat er los bij. De schakelaar zelf heeft een witte knop,
                     en die valt op een witte kaart nauwelijks op: Ibrahim zag hem niet staan en dacht
                     dat de instelling er niet was. Een schakelaar die je moet zoeken is geen schakelaar. -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" MinimumHeightRequest="48">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{t:T meer.donker-thema}" Style="{StaticResource CardTitle}" />
                        <Label Text="{t:T meer.uit-zet-de-app-op}" Style="{StaticResource SubtitleLabel}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding ThemaStand}" VerticalOptions="Center"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource TextBodyDark}}" />
                    <Switch Grid.Column="2" IsToggled="{Binding IsDonkerThema}" VerticalOptions="Center"
                            ThumbColor="{Binding ThemaKnopKleur}" />
                </Grid>
            </Border>

            <!-- Taal. Staat bij weergave en niet onderaan: het is het soort instelling dat je één keer
                 zoekt en meteen wil vinden. De namen staan in de taal zelf; wie Turks zoekt zoekt
                 "Türkçe" en niet "Turks". -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{t:T meer.taal}" Style="{StaticResource CardTitle}" />
                    <Border Style="{StaticResource InputBorder}">
                        <!-- x:DataType in de binding zelf: een ItemDisplayBinding kijkt naar een
                             regel uit de lijst en niet naar de viewmodel, dus moet het type daar
                             staan. Zonder dat wordt deze binding niet gecompileerd en zou "Naam"
                             pas op een toestel leeg blijken. -->
                        <Picker ItemsSource="{Binding Talen}"
                                ItemDisplayBinding="{Binding Naam, x:DataType=t:TaalKeuze}"
                                SelectedItem="{Binding GekozenTaal}" />
                    </Border>
                    <Label Text="{t:T meer.taal-uitleg}" Style="{StaticResource StatCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Je woning. De plaats staat hier omdat er zonder plaats geen zonverwachting is, en
                 het adviesscherm daar anders naar een veld verwijst dat nergens bestond. -->
            <Label Text="{t:T woning.titel}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{t:T woning.uitleg}" Style="{StaticResource SubtitleLabel}" FontSize="14" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{t:T woning.naam}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding WoningNaam}" Placeholder="{t:Ts inlog.bijvoorbeeld-thuis}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{t:T woning.plaats}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding Plaats}" Placeholder="{t:Ts woning.plaats-voorbeeld}" />
                        </Border>
                        <Label Text="{Binding ZonStatus}" Style="{StaticResource StatCaption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{t:T woning.piek}" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding PiekVermogen}" Keyboard="Numeric" Placeholder="4,2" />
                            </Border>
                            <Label Grid.Column="1" Text="kWp" Style="{StaticResource SubtitleLabel}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding PanelenTekst}" Style="{StaticResource StatCaption}"
                               IsVisible="{Binding HeeftPanelen}"
                               TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />
                        <Label Text="{t:T woning.piek-uitleg}" Style="{StaticResource StatCaption}" />

                        <!-- Wij kunnen het zelf uitrekenen uit de opwek en de zon die erop viel, dus
                             sturen we niemand naar een offerte van jaren geleden. -->
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HeeftSchatting}">
                            <Label Text="{Binding SchattingTekst}" Style="{StaticResource StatCaption}" />
                            <Button Text="{t:T woning.schatting-overnemen}"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalOptions="Start"
                                    Command="{Binding SchattingOvernemenCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding WoningFout}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HeeftWoningFout}" />
                    <Label Text="{Binding WoningBewaard}" Style="{StaticResource SubtitleLabel}" FontSize="14"
                           IsVisible="{Binding HeeftWoningBewaard}" />

                    <Button Text="{t:T woning.opslaan}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding WoningOpslaanCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- LaadCash. Alleen zichtbaar als de server zegt dat er iets te tonen is. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HeeftLaadcash}">
                <Label Text="{t:T meer.laadcash}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding LaadcashTitel}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding LaadcashTekst}" Style="{StaticResource SubtitleLabel}"
                               IsVisible="{Binding LaadcashTekst, Converter={StaticResource IsNotNullOrEmpty}}" />
                        <Label Text="{t:T meer.laadcash-is-net-als-wattzicht}"
                               Style="{StaticResource SubtitleLabel}" FontSize="13"
                               IsVisible="{Binding LaadcashNogNiet}" />
                        <Button Text="{t:T meer.meer-weten-over-laadcash}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding LaadcashOpenenCommand}"
                                IsVisible="{Binding LaadcashNogNiet}" />
                        <Label Text="{t:T meer.je-bent-gekoppeld-met-laadcash}"
                               Style="{StaticResource SubtitleLabel}"
                               IsVisible="{Binding LaadcashGekoppeld}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label Text="{t:T meer.je-energietarief}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <!-- Vier bedragen overtikken uit een pdf is precies waar iemand op afhaakt. -->
                    <Button Text="{t:T contract.knop}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ContractLezenCommand}" />
                    <Label Text="{t:T contract.uitleg}" Style="{StaticResource StatCaption}" />
                    <Label Text="{Binding ContractResultaat}"
                           Style="{StaticResource SubtitleLabel}" FontSize="14"
                           IsVisible="{Binding HeeftContractResultaat}" />

                    <Label Text="{t:T meer.hiermee-rekenen-we-uit-wat}"
                           Style="{StaticResource SubtitleLabel}" FontSize="14" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{t:T meer.dynamisch-contract}" Style="{StaticResource CardTitle}" />
                            <Label Text="{t:T meer.uurprijzen-van-de-markt-in}" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsDynamic}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsDynamic, Converter={StaticResource InvertedBool}}">
                        <Label Text="{t:T meer.leveringstarief-per-kwh}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding ImportTariff}" Keyboard="Numeric" Placeholder="0,30" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding ImportTariffError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasImportTariffError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsDynamic}">
                        <Label Text="{t:T meer.gemiddeld-leveringstarief-per-kwh}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding ImportTariff}" Keyboard="Numeric" Placeholder="0,25" />
                            </Grid>
                        </Border>
                        <Label Text="{t:T meer.bij-dynamisch-gebruiken-we-dit}" Style="{StaticResource StatCaption}" />
                        <Label Text="{Binding ImportTariffError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasImportTariffError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{t:T meer.terugleververgoeding-per-kwh}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding ExportTariff}" Keyboard="Numeric" Placeholder="0,08" />
                            </Grid>
                        </Border>
                        <Label Text="{t:T meer.tot-31-12-2026-geldt}" Style="{StaticResource StatCaption}" />
                        <Label Text="{Binding ExportTariffError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasExportTariffError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{t:T meer.terugleverkosten-per-kwh}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="€" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" FontSize="15" />
                                <Entry Grid.Column="1" Text="{Binding FeedInCost}" Keyboard="Numeric" Placeholder="0,120" />
                            </Grid>
                        </Border>
                        <Label Text="{t:T meer.staat-op-je-contract-of}"
                               Style="{StaticResource StatCaption}" />
                        <Label Text="{Binding FeedInCostError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasFeedInCostError}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding TariffSavedText}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}"
                           IsVisible="{Binding TariffSavedText, Converter={StaticResource IsNotNullOrEmpty}}" />

                    <Grid>
                        <Button Text="{t:T meer.tarief-opslaan}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTariffCommand}"
                                IsEnabled="{Binding IsSavingTariff, Converter={StaticResource InvertedBool}}" />
                        <ActivityIndicator IsRunning="{Binding IsSavingTariff}" IsVisible="{Binding IsSavingTariff}"
                                           Color="{StaticResource Navy900}" HorizontalOptions="End" Margin="0,0,16,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Installateur =====
                 Alleen als er een is. Wie zich zelf heeft aangemeld heeft geen installateur, en dan
                 stond hier een kaart met een lege naam en een schakelaar voor iemand die er niet is. -->
            <Label Text="{t:T meer.je-installateur}" Style="{StaticResource SectionTitle}"
                   IsVisible="{Binding HeeftInstallateur}" />
            <Border Style="{StaticResource Card}" IsVisible="{Binding HeeftInstallateur}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*" ColumnSpacing="12">
                        <!--
                            Alleen de naam en het telefoonnummer. Wattzicht blijft het merk van de app;
                            een logo van de installateur ernaast leest als een tweede merk.
                        -->
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{t:T meer.jouw-installateur}" Style="{StaticResource StatCaption}" />
                            <Label Text="{Binding InstallerName}" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding InstallerPhone}" Style="{StaticResource SubtitleLabel}" IsVisible="{Binding HasInstallerPhone}" />
                            <Label Text="{t:T meer.voor-vragen-over-je-installatie}" Style="{StaticResource SubtitleLabel}" IsVisible="{Binding HasInstallerPhone, Converter={StaticResource InvertedBool}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="{t:T meer.bel-installateur}" Style="{StaticResource SecondaryButton}" Command="{Binding CallInstallerCommand}" IsVisible="{Binding HasInstallerPhone}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{t:T meer.installateur-mag-meekijken}" Style="{StaticResource CardTitle}" />
                            <Label Text="{t:T meer.dan-ziet-je-installateur-storingen}"
                                   Style="{StaticResource SubtitleLabel}" />
                            <Label Text="{Binding LastViewedText}" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding InstallerAccess}" VerticalOptions="Center"
                                SemanticProperties.Description="{t:T schermlezer.installateur-meekijken}" />
                    </Grid>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="{t:T meer.nog-geen-thuisbatterij-sla-je}" FontSize="14" />
                    <Button Text="{t:T meer.vraag-offerte-voor-thuisbatterij}" Style="{StaticResource PrimaryButton}" Command="{Binding RequestQuoteCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== Meldingen ===== -->
            <Label Text="{t:T meer.meldingen}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{t:T meer.bij-een-storing}" Style="{StaticResource CardTitle}" />
                            <Label Text="{t:T meer.als-een-apparaat-geen-data}" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NotifyAlerts}" VerticalOptions="Center"
                                SemanticProperties.Description="{t:T schermlezer.melding-storing}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{t:T meer.bij-veel-terugleveren}" Style="{StaticResource CardTitle}" />
                            <Label Text="{t:T meer.tip-om-je-stroom-zelf}" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NotifySurplus}" VerticalOptions="Center"
                                SemanticProperties.Description="{t:T schermlezer.melding-teruglevering}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{t:T meer.maandbericht}" Style="{StaticResource CardTitle}" />
                            <Label Text="{t:T meer.maandbericht-uitleg}" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NotifyMonthly}" VerticalOptions="Center"
                                SemanticProperties.Description="{t:T schermlezer.maandbericht}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Historie uit het portaal van de fabrikant. Wij meten vanaf de dag dat je koppelt; de
                 jaren daarvoor staan bij Enphase en die kun je daar downloaden. -->
            <Label Text="{t:T historie.titel}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{t:T historie.uitleg}" Style="{StaticResource SubtitleLabel}" FontSize="14" />
                    <Label Text="{t:T historie.stappen}" Style="{StaticResource StatCaption}" />
                    <Button Text="{t:T historie.knop}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding HistorieImporterenCommand}" />
                    <Label Text="{Binding ImportResultaat}"
                           Style="{StaticResource SubtitleLabel}"
                           FontSize="14"
                           IsVisible="{Binding HeeftImportResultaat}" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== Account ===== -->
            <Label Text="{t:T meer.account}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Button Text="{t:T meer.uitloggen}" Style="{StaticResource SecondaryButton}"
                            TextColor="{AppThemeBinding Light={StaticResource ErrorDot}, Dark={StaticResource ErrorTextDark}}"
                            BorderColor="{AppThemeBinding Light={StaticResource ErrorDot}, Dark={StaticResource ErrorTextDark}}"
                            Command="{Binding LogoutCommand}" />

                    <!-- Je eigen meting meenemen. Hoort bij je account en niet bij de grafieken. -->
                    <Button Text="{t:T gegevens.knop}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding GegevensDelenCommand}" />
                    <Label Text="{t:T gegevens.uitleg}" Style="{StaticResource StatCaption}" />

                    <!-- Wachtwoord wijzigen. Dichtgeklapt, want het is iets wat je een keer doet. -->
                    <Button Text="{t:T wachtwoord.knop}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding WachtwoordSchakelenCommand}" />

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding WachtwoordOpen}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{t:T wachtwoord.huidig}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding HuidigWachtwoord}" IsPassword="True" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{t:T wachtwoord.nieuw}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding NieuwWachtwoord}" IsPassword="True" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="{t:T algemeen.opslaan}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding WachtwoordOpslaanCommand}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding WachtwoordBericht}" Style="{StaticResource SubtitleLabel}" FontSize="14"
                           IsVisible="{Binding HeeftWachtwoordBericht}" />

                    <!-- Verwijderen staat los van uitloggen, en bewust minder opvallend: het is het
                         enige in deze app dat je niet terug kunt draaien. -->
                    <Button Text="{t:T meer.account-verwijderen}"
                            Style="{StaticResource LinkButton}"
                            TextColor="{AppThemeBinding Light={StaticResource ErrorDot}, Dark={StaticResource ErrorTextDark}}"
                            Command="{Binding AccountVerwijderenCommand}" />
                    <Label Text="{t:T meer.hiermee-verdwijnen-je-huishouden-je}"
                           Style="{StaticResource StatCaption}" HorizontalTextAlignment="Center" />

                    <Label Text="{Binding VersionText}" Style="{StaticResource StatCaption}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ApiText}" Style="{StaticResource StatCaption}" HorizontalTextAlignment="Center" Opacity="0.7" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
