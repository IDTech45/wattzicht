<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wattzicht.App.ViewModels"
             x:Class="Wattzicht.App.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Inloggen"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource BgApp}, Dark={StaticResource BgAppDark}}">

    <ScrollView>
        <!--
            Rijen op Auto en niet op ster. In een ScrollView is de hoogte oneindig, dus een sterrij
            krijgt daar geen zinnige maat: het scherm werd afgemeten op iets anders dan wat erin
            paste en de knop viel onderlangs weg, zonder dat je eronder kon scrollen. Met Auto meet
            alles zichzelf op en scrollt de pagina gewoon als er meer bij komt, zoals nu met
            aanmelden en de Google-knop.
        -->
        <Grid RowDefinitions="Auto,Auto,Auto" Padding="24,32,24,24" RowSpacing="24">

            <!-- Logo en woordmerk -->
            <VerticalStackLayout Grid.Row="0" Spacing="12" HorizontalOptions="Center">
                <Image Source="logo.png" HeightRequest="96" WidthRequest="96"
                       SemanticProperties.Description="Wattzicht-logo" />
                <Label HorizontalTextAlignment="Center" FontSize="30" FontFamily="Display"
                       TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource TextBodyDark}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Watt" FontFamily="DisplayBold" />
                            <Span Text="zicht" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Zie wat je bespaart"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Formulier -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Alleen bij aanmelden: de naam van het huishouden, en optioneel de code van
                         een installateur. Die code is nadrukkelijk niet verplicht; iedereen kan zich
                         aanmelden en zijn apparaten koppelen. -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRegistreren}">
                        <Label Text="Naam van je huishouden" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding HouseholdName}"
                                   Placeholder="Bijvoorbeeld Thuis"
                                   ReturnType="Next"
                                   AutomationId="HouseholdNameEntry" />
                        </Border>
                        <Label Text="{Binding HouseholdNameError}"
                               Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding HasHouseholdNameError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="E-mailadres" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding Email}"
                                   Placeholder="naam@voorbeeld.nl"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   AutomationId="EmailEntry" />
                        </Border>
                        <Label Text="{Binding EmailError}"
                               Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding HasEmailError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Wachtwoord" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       Text="{Binding Password}"
                                       Placeholder="Je wachtwoord"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       ReturnType="Go"
                                       ReturnCommand="{Binding LoginCommand}"
                                       AutomationId="PasswordEntry" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource LinkButton}"
                                        Text="Toon"
                                        MinimumWidthRequest="72"
                                        Padding="8,0"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        SemanticProperties.Description="Wachtwoord tonen of verbergen" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding PasswordError}"
                               Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding HasPasswordError}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabel}"
                           IsVisible="{Binding HasError}" />

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRegistreren}">
                        <Label Text="Code van je installateur (niet verplicht)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding InstallerCode}"
                                   Placeholder="Alleen als je via een installateur komt"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   AutomationId="InstallerCodeEntry" />
                        </Border>
                        <Label Text="Vul je een code in, dan mag die installateur je gegevens zien en je helpen."
                               Style="{StaticResource SubtitleLabel}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Grid IsVisible="{Binding IsRegistreren, Converter={StaticResource InvertedBool}}">
                        <Button Text="Inloggen"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextOnAccent}}"
                                           HorizontalOptions="End"
                                           Margin="0,0,16,0" />
                    </Grid>

                    <Grid IsVisible="{Binding IsRegistreren}">
                        <Button Text="Account aanmaken"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextOnAccent}}"
                                           HorizontalOptions="End"
                                           Margin="0,0,16,0" />
                    </Grid>

                    <!-- Inloggen met een account dat je al hebt. Staat onder de gewone knop: wie een
                         wachtwoord bij ons heeft hoort niet eerst langs Google te moeten. -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ToonSociaal}">
                        <Label Text="of"
                               Style="{StaticResource SubtitleLabel}"
                               FontSize="13"
                               HorizontalOptions="Center" />

                        <Button Text="Doorgaan met Google"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="{Binding ToonGoogle}"
                                IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding SociaalCommand}"
                                CommandParameter="google" />

                        <Button Text="Doorgaan met Apple"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="{Binding ToonApple}"
                                IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding SociaalCommand}"
                                CommandParameter="apple" />
                    </VerticalStackLayout>

                    <Button Text="{Binding WisselTekst}"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding ToggleRegistrerenCommand}" />
                </VerticalStackLayout>
            </Border>

            <BoxView Grid.Row="2" HeightRequest="24" Color="Transparent" />
        </Grid>
    </ScrollView>
</ContentPage>
