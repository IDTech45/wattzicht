<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wattzicht.App.ViewModels"
             x:Class="Wattzicht.App.Pages.AdvicePage"
             x:DataType="vm:AdviceViewModel"
             Title="Slim sturen">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Tips}" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,8,16,8" Spacing="12">
                    <Label Text="Slim sturen · vandaag" Style="{StaticResource SubtitleLabel}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding TotalText}" Style="{StaticResource StatValueLarge}" TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" />
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding Subtitle}" Style="{StaticResource SubtitleLabel}" />

                    <Border Style="{StaticResource DangerCard}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" />
                    </Border>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasPrices}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CheapestText}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" />
                            <Label Text="{Binding ExpensiveText}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="Uurprijzen inclusief belasting (schatting)" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <!--
                        De laadplanner. Hij stond al op de server maar nergens in de app, terwijl dit
                        de concretere vraag beantwoordt die een bewoner echt heeft: ik moet er
                        morgenvroeg zoveel in hebben, wanneer zet ik hem aan. De planner weegt de
                        uurprijs tegen de zon die op zijn eigen dak verwacht wordt.
                    -->
                    <Border Style="{StaticResource Card}" Margin="16,8,16,0">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Wanneer laad ik mijn auto?" Style="{StaticResource CardTitle}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Hoeveel erin moet" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InputBorder}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Entry Text="{Binding PlanKwh}" Keyboard="Numeric" />
                                            <Label Grid.Column="1" Text="kWh" VerticalOptions="Center"
                                                   Style="{StaticResource SubtitleLabel}" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Klaar om" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InputBorder}">
                                        <TimePicker Time="{Binding PlanKlaarOm}" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Bereken" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding MaakLaadplanCommand}" IsEnabled="{Binding PlanBusy, Converter={StaticResource InvertedBool}}" />

                            <Label Text="{Binding PlanError}" Style="{StaticResource ErrorLabel}"
                                   IsVisible="{Binding PlanHasError}" />

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPlan}">
                                <Label Text="{Binding PlanSummary}" Style="{StaticResource SubtitleLabel}" />
                                <Label Text="{Binding PlanSavingText}" Style="{StaticResource CardTitle}" FontSize="14"
                                       IsVisible="{Binding PlanHasSaving}"
                                       TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />

                                <BoxView Style="{StaticResource DividerLine}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlanSlots}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChargeSlotRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Label Text="{Binding TimeText}" Style="{StaticResource StatValue}" FontSize="15" />
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="{Binding KwhText}" Style="{StaticResource CardTitle}" FontSize="14" />
                                                    <Label Text="{Binding SolarText}" Style="{StaticResource StatCaption}"
                                                           IsVisible="{Binding HasSolar}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding CostText}" Style="{StaticResource StatValue}"
                                                       FontSize="15" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,24" Spacing="8" HorizontalOptions="Center" IsVisible="{Binding HasLoaded}">
                    <Label Text="Nog geen tips" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                    <Label Text="Koppel je zonnepanelen, batterij of laadpaal, of zet bij Instellingen een dynamisch contract aan."
                           Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AdviceTipRow">
                    <Border Style="{StaticResource Card}" Margin="16,4" Padding="14,12">
                        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <BoxView Grid.RowSpan="3" WidthRequest="4" CornerRadius="2" Color="{Binding AccentColor}" />
                            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource StatCaption}" />
                            <Label Grid.Column="1" Grid.Row="2" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                   Style="{StaticResource StatCaption}" TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" />
                            <Label Grid.Column="2" Grid.RowSpan="3" Text="{Binding SavingText}" IsVisible="{Binding HasSaving}"
                                   FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Text="Automatisch sturen komt binnenkort voor laadpalen en batterijen."
                       Style="{StaticResource StatCaption}" HorizontalTextAlignment="Center" Padding="16,12,16,32" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
