<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Wattzicht.App.Services"
             xmlns:vm="clr-namespace:Wattzicht.App.ViewModels"
             x:Class="Wattzicht.App.Pages.SavingsPage"
             x:DataType="vm:SavingsViewModel"
             Title="{t:Ts besparen.besparing}">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,8,16,8" Spacing="12">
                    <Label Text="{t:T besparen.besparing}" Style="{StaticResource PageTitle}" />

                    <!-- Segment Dag/Week/Maand/Jaar -->
                    <Border Style="{StaticResource Card}" Padding="4" StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                            <Button Grid.Column="0" Text="{t:T besparen.dag}" Command="{Binding SetPeriodCommand}" CommandParameter="Day">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsDay}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Accent500}" />
                                                <Setter Property="TextColor" Value="{StaticResource Navy900}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Text="{t:T besparen.week}" Command="{Binding SetPeriodCommand}" CommandParameter="Week">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsWeek}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Accent500}" />
                                                <Setter Property="TextColor" Value="{StaticResource Navy900}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2" Text="{t:T besparen.maand}" Command="{Binding SetPeriodCommand}" CommandParameter="Month">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsMonth}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Accent500}" />
                                                <Setter Property="TextColor" Value="{StaticResource Navy900}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="3" Text="{t:T besparen.jaar}" Command="{Binding SetPeriodCommand}" CommandParameter="Year">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsYear}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Accent500}" />
                                                <Setter Property="TextColor" Value="{StaticResource Navy900}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DangerCard}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" />
                    </Border>

                    <!-- Totaal + grafiek -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding PeriodTitle}" Style="{StaticResource SubtitleLabel}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding TotalSavedText}" Style="{StaticResource StatValueLarge}" TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" />
                                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
                            </Grid>
                            <GraphicsView x:Name="ChartView"
                                          Drawable="{Binding Chart}"
                                          HeightRequest="160"
                                          Margin="0,8,0,0"
                                          SemanticProperties.Description="Staafgrafiek van je besparing per dag" />
                            <BoxView Style="{StaticResource DividerLine}" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{t:T besparen.opgewekt}" Style="{StaticResource StatCaption}" />
                                    <Label Text="{Binding TotalPvText}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{t:T besparen.zelf-gebruikt}" Style="{StaticResource StatCaption}" />
                                    <Label Text="{Binding TotalSelfUseText}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="{t:T besparen.teruggeleverd}" Style="{StaticResource StatCaption}" />
                                    <Label Text="{Binding TotalExportText}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" Spacing="2">
                                    <Label Text="{t:T besparen.geladen}" Style="{StaticResource StatCaption}" />
                                    <Label Text="{Binding TotalChargedText}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource PendingText}, Dark={StaticResource PendingTextDark}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Duurzaamheid dit jaar -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasSustainability}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{t:T besparen.dit-jaar}" Style="{StaticResource SubtitleLabel}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding YearPvText}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}" />
                                    <Label Text="{t:T besparen.opgewekt-2}" Style="{StaticResource StatCaption}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Co2Text}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />
                                    <Label Text="{t:T besparen.co2-vermeden}" Style="{StaticResource StatCaption}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="{Binding SelfSufficiencyText}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{t:T besparen.zelfvoorzienend}" Style="{StaticResource StatCaption}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding PerformanceText}" FontSize="14">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding PerformanceLow}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource ErrorDot}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Terugleveren -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasFeedIn}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{t:T besparen.terugleveren}" Style="{StaticResource SubtitleLabel}" />
                            <Label Text="{Binding FeedInMonthText}" Style="{StaticResource CardTitle}" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding FeedInYearText}" Style="{StaticResource StatCaption}" />
                            <Label Text="{Binding FeedIn2027Text}" FontSize="14" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Wat de leverancier per maand zegt, met onze eigen meting ernaast. Voor wie
                         geen P1-meter heeft is dit de enige plek waar de netkant staat. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HeeftLeverancierCijfers}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{t:T verbruik.titel}" Style="{StaticResource CardTitle}" />
                            <Label Text="{t:T verbruik.uitleg}" Style="{StaticResource StatCaption}" />

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                <Label Text="{t:T verbruik.kop-maand}" Style="{StaticResource StatCaption}" />
                                <Label Grid.Column="1" Text="{t:T verbruik.kop-afname}" Style="{StaticResource StatCaption}" />
                                <Label Grid.Column="2" Text="{t:T verbruik.kop-terug}" Style="{StaticResource StatCaption}" />
                                <Label Grid.Column="3" Text="{t:T verbruik.kop-wij}" Style="{StaticResource StatCaption}" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LeverancierMaanden}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeverancierRij">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding MaandTekst}" Style="{StaticResource SubtitleLabel}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding AfnameTekst}" Style="{StaticResource SubtitleLabel}" FontSize="14" />
                                            <Label Grid.Column="2" Text="{Binding TerugTekst}" Style="{StaticResource SubtitleLabel}" FontSize="14" />
                                            <Label Grid.Column="3" Text="{Binding OnzeTekst}" Style="{StaticResource StatCaption}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{t:T besparen.per-dag}" Style="{StaticResource SectionTitle}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,24" Spacing="8" HorizontalOptions="Center" IsVisible="{Binding HasLoaded}">
                    <Label Text="{t:T besparen.nog-geen-dagen}" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                    <Label Text="{t:T besparen.zodra-je-apparaten-een-dag}" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryRow">
                    <Border Style="{StaticResource Card}" Margin="16,4" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource CardTitle}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding SavedText}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                                <Label Text="{Binding PvText, StringFormat='☀ {0}'}" Style="{StaticResource StatCaption}" />
                                <Label Text="{Binding SelfUseText, StringFormat='⌂ {0}'}" Style="{StaticResource StatCaption}" />
                                <Label Text="{Binding ExportText, StringFormat='▲ {0}'}" Style="{StaticResource StatCaption}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Text="{t:T besparen.opgewekt-zelf-gebruikt-teruggeleverd}" Style="{StaticResource StatCaption}" HorizontalTextAlignment="Center" Padding="16,12,16,32" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
