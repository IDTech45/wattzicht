<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wattzicht.App.ViewModels"
             x:Class="Wattzicht.App.Pages.ConnectDevicePage"
             x:DataType="vm:ConnectDeviceViewModel"
             Title="Apparaat koppelen">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="12">

                <Label Text="{Binding StepText}" Style="{StaticResource SubtitleLabel}" />

                <!-- Voortgang -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" Color="{StaticResource Accent500}" />
                    <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2"
                             Color="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding IsStep1}" Value="False">
                                <Setter Property="Color" Value="{StaticResource Accent500}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                    <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2"
                             Color="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding IsStep3}" Value="True">
                                <Setter Property="Color" Value="{StaticResource Accent500}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                </Grid>

                <!-- Algemene fout -->
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" FontSize="14" IsVisible="{Binding HasError}" />

                <!-- ================= STAP 1: merk ================= -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep1}">
                    <Label Text="Wat wil je koppelen?" Style="{StaticResource PageTitle}" />
                    <Label Text="Kies eerst het soort apparaat, daarna het merk." Style="{StaticResource SubtitleLabel}" FontSize="14" />

                    <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Groepen}">
                      <BindableLayout.ItemTemplate>
                       <DataTemplate x:DataType="vm:BrandGroep">
                        <VerticalStackLayout Spacing="8">
                         <Label Text="{Binding Titel}" Style="{StaticResource SectionTitle}" />
                         <Label Text="{Binding Uitleg}" Style="{StaticResource SubtitleLabel}" FontSize="13" />

                         <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Merken}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:BrandOption">
                                <Border Style="{StaticResource Card}" Padding="12" MinimumHeightRequest="64">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Accent500}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConnectDeviceViewModel}}, Path=SelectBrandCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                                StrokeShape="Ellipse" BackgroundColor="{Binding Accent}" VerticalOptions="Center">
                                            <Label Text="{Binding Initial}" FontSize="18" FontAttributes="Bold"
                                                   TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding Description}" Style="{StaticResource SubtitleLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="✓" FontSize="22" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}" VerticalOptions="Center"
                                               IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                         </VerticalStackLayout>
                        </VerticalStackLayout>
                       </DataTemplate>
                      </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ================= STAP 2: gegevens ================= -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep2}">
                    <Label Text="{Binding BrandName, StringFormat='{0} koppelen'}" Style="{StaticResource PageTitle}" />

                    <!-- Growatt -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsGrowatt}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Je vindt je API-token in de ShinePhone-app: ga naar Ik → API Token en kopieer de code."
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="API-token" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding ApiToken}" Placeholder="Plak hier je token" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                </Border>
                                <Label Text="{Binding ApiTokenError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasApiTokenError}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SolaX -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsSolax}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding SolaxHelp}"
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="TokenID" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding ApiToken}" Placeholder="Plak hier je TokenID" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                </Border>
                                <Label Text="{Binding ApiTokenError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasApiTokenError}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding SolaxSnLabel}" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding DongleSn}" Placeholder="{Binding SolaxSnPlaceholder}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MaxLength="20" />
                                </Border>
                                <Label Text="{Binding DongleSnError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasDongleSnError}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Sessy -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsSessy}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Gebruikersnaam en wachtwoord staan op de sticker van je Sessy-dongle. Het IP-adres vind je in je router of de Sessy-app."
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="IP-adres van de dongle" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding IpAddress}" Placeholder="192.168.1.50" Keyboard="Url" />
                                </Border>
                                <Label Text="{Binding IpAddressError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasIpAddressError}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Gebruikersnaam" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding Username}" Placeholder="Zie sticker" IsSpellCheckEnabled="False" />
                                </Border>
                                <Label Text="{Binding UsernameError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasUsernameError}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Wachtwoord" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding Password}" Placeholder="Zie sticker" IsPassword="True" />
                                </Border>
                                <Label Text="{Binding PasswordError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasPasswordError}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Enphase: de gateway in de meterkast, niet de cloud van Enphase -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsEnphase}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Je telefoon praat rechtstreeks met de IQ Gateway in je meterkast, dus dit werkt alleen thuis op je eigen wifi. Zo kunnen we ook zien wat je van het net haalt en teruglevert; via de cloud van Enphase kan dat niet."
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="IP-adres van de gateway" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding IpAddress}" Placeholder="192.168.1.30" Keyboard="Url" />
                                </Border>
                                <Label Text="{Binding IpAddressError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasIpAddressError}" />
                                <!-- Dat adres staat nergens op het kastje; de telefoon kan het zelf opzoeken. -->
                                <Button Text="Zoek mijn gateway op wifi"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ZoekApparaatCommand}"
                                        IsEnabled="{Binding IsZoeken, Converter={StaticResource InvertedBool}}" />
                                <Label Text="{Binding ZoekResultaat}" Style="{StaticResource SubtitleLabel}"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}"
                                       IsVisible="{Binding ZoekResultaat, Converter={StaticResource IsNotNullOrEmpty}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Token van je gateway" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding ApiToken}" Placeholder="eyJ..." IsSpellCheckEnabled="False" />
                                </Border>
                                <Label Text="{Binding ApiTokenError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasApiTokenError}" />
                            </VerticalStackLayout>
                            <Label Text="Het token haal je op bij entrez.enphaseenergy.com: log in met je eigen Enphase-account en vul het serienummer van de gateway in. Met je eigen account is het een jaar geldig."
                                   Style="{StaticResource SubtitleLabel}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Alfen: de paal zelf op het thuisnetwerk, niet via een portaal -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsAlfen}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Je telefoon praat rechtstreeks met de laadpaal, dus dit werkt alleen thuis op je eigen wifi. Het IP-adres vind je in je router; het wachtwoord heb je van je installateur gekregen."
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="IP-adres van de laadpaal" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding IpAddress}" Placeholder="192.168.1.42" Keyboard="Url" />
                                </Border>
                                <Label Text="{Binding IpAddressError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasIpAddressError}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Wachtwoord van de laadpaal" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding Password}" Placeholder="Van je installateur" IsPassword="True" />
                                </Border>
                                <Label Text="{Binding PasswordError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasPasswordError}" />
                            </VerticalStackLayout>
                            <Label Text="Hangt je paal alleen aan een simkaart van je leverancier, dan heeft hij thuis geen adres en lukt dit niet."
                                   Style="{StaticResource SubtitleLabel}" FontSize="13" />
                            <!--
                                Veel Alfens in Nederland staan onder een laadpas-backoffice: 50five,
                                E-Flux, een leasemaatschappij. Dat hoeft niet in de weg te zitten,
                                want wij praten met de paal zelf en niet met die backoffice. Maar
                                mensen denken van wel en haken daarop af, dus staat het er gewoon.
                            -->
                            <Label Text="Staat je paal onder 50five, E-Flux of je leasemaatschappij? Dat mag. Wij lezen de paal zelf uit op je eigen netwerk en komen niet in hun portaal; je laadpas en je afrekening blijven gewoon lopen zoals ze liepen."
                                   Style="{StaticResource SubtitleLabel}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Peblar: de paal zelf op het thuisnetwerk, met een token uit de paal -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsPeblar}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Je telefoon praat rechtstreeks met de laadpaal, dus dit werkt alleen thuis op je eigen wifi. Zet eerst in de webinterface van de paal de lokale API aan en maak daar een token aan."
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="IP-adres van de laadpaal" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding IpAddress}" Placeholder="192.168.1.42" Keyboard="Url" />
                                </Border>
                                <Label Text="{Binding IpAddressError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasIpAddressError}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="API-token van de laadpaal" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding ApiToken}" Placeholder="Uit de webinterface van de paal" />
                                </Border>
                                <Label Text="{Binding ApiTokenError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasApiTokenError}" />
                            </VerticalStackLayout>
                            <Label Text="Maak je later een nieuw token aan, dan vervalt dit token en moet je hier opnieuw koppelen."
                                   Style="{StaticResource SubtitleLabel}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Zaptec: hetzelfde account als in de Zaptec-app zelf -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsZaptec}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Gebruik het e-mailadres en wachtwoord waarmee je in de Zaptec-app inlogt. Wij lezen alleen uit; sturen doen we niet."
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="E-mailadres" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding Username}" Placeholder="jij@voorbeeld.nl" Keyboard="Email" IsSpellCheckEnabled="False" />
                                </Border>
                                <Label Text="{Binding UsernameError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasUsernameError}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Wachtwoord" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding Password}" IsPassword="True" />
                                </Border>
                                <Label Text="{Binding PasswordError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasPasswordError}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- P1-meter: een dongle op de slimme meter, welk merk dan ook -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsHomeWizard}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Zet in de app van je dongle de lokale API aan en vul het IP-adres in. Bij HomeWizard staat dat onder Instellingen, Meters, P1-meter, Lokale API."
                                   Style="{StaticResource SubtitleLabel}" FontSize="14" />
                            <Label Text="Je telefoon moet op hetzelfde wifi-netwerk zitten als de meter. Wij lezen hem uit zodra je de app thuis opent; buitenshuis kan het niet."
                                   Style="{StaticResource StatCaption}" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="IP-adres van de P1-meter" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding IpAddress}" Placeholder="192.168.1.60" Keyboard="Url" />
                                </Border>
                                <Label Text="{Binding IpAddressError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasIpAddressError}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Demo -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsDemo}">
                        <Label Text="Je hoeft niets in te vullen. We voegen een voorbeeldomvormer, -batterij en -laadpaal toe met realistische data."
                               Style="{StaticResource SubtitleLabel}" FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- ================= STAP 3: bevestigen ================= -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep3}">
                    <Label Text="Klopt dit?" Style="{StaticResource PageTitle}" IsVisible="{Binding IsDone, Converter={StaticResource InvertedBool}}" />
                    <Label Text="Gekoppeld" Style="{StaticResource PageTitle}" IsVisible="{Binding IsDone}" />

                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsDone, Converter={StaticResource InvertedBool}}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Merk" Style="{StaticResource FieldLabel}" WidthRequest="90" />
                                <Label Grid.Column="1" Text="{Binding BrandName}" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Gegevens" Style="{StaticResource FieldLabel}" WidthRequest="90" />
                                <Label Grid.Column="1" Text="{Binding SummaryLine}" />
                            </Grid>
                            <Label Text="We controleren de gegevens en halen je apparaten op. Dit duurt een paar seconden."
                                   Style="{StaticResource SubtitleLabel}" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsDone}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource EnergyBatterySoft}, Dark={StaticResource EnergyBatterySoftDark}}"
                            Stroke="{StaticResource EnergyBattery}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="✓" FontSize="36" TextColor="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />
                            <Label Text="{Binding DoneText}" FontSize="16" />
                            <Label Text="Binnen een paar minuten zie je de eerste metingen op Home." Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Knoppenbalk -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,8,16,16"
              BackgroundColor="{AppThemeBinding Light={StaticResource BgApp}, Dark={StaticResource BgAppDark}}">
            <Button Grid.Column="0" Text="Terug" Style="{StaticResource SecondaryButton}" WidthRequest="110"
                    Command="{Binding BackCommand}" IsEnabled="{Binding IsNotBusy}"
                    IsVisible="{Binding IsDone, Converter={StaticResource InvertedBool}}" />
            <Grid Grid.Column="1" IsVisible="{Binding IsDone, Converter={StaticResource InvertedBool}}">
                <Button Text="{Binding PrimaryButtonText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NextCommand}" IsEnabled="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Navy900}" HorizontalOptions="End" Margin="0,0,16,0" />
            </Grid>
            <Button Grid.ColumnSpan="2" Text="Klaar" Style="{StaticResource PrimaryButton}"
                    Command="{Binding FinishCommand}" IsVisible="{Binding IsDone}" />
        </Grid>
    </Grid>
</ContentPage>
