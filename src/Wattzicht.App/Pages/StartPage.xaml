<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wattzicht.App.Pages.StartPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Navy900}">

    <!-- Het oog van het logo knippert een keer en dan begint de app. Geen voortgangsbalk en geen
         percentage: het duurt een seconde, en in die seconde doen we het werk dat er toch moet
         gebeuren (token verversen, weten waar je heen moet). -->
    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="18">
            <!-- Meteen zichtbaar en op ware grootte: Android laat vlak hiervoor zijn eigen
                 opstartscherm zien met ditzelfde logo. Begonnen we hier op nul, dan zag je het
                 logo staan, verdwijnen en opnieuw opkomen. Nu loopt het door. -->
            <Image x:Name="Logo"
                   Source="logo.png"
                   HeightRequest="112" WidthRequest="112"
                   SemanticProperties.Description="Wattzicht" />
            <!-- Zoals het logo: "watt" wit, "zicht" geel. Het stond hier helemaal in het wit, en
                 dan is het ineens een ander merk dan op de site en op het pictogram. -->
            <Label x:Name="Naam"
                   FontSize="26"
                   FontAttributes="Bold"
                   Opacity="0"
                   HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="watt" TextColor="{StaticResource White}" />
                        <Span Text="zicht" TextColor="{StaticResource Accent500}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <!-- De regel die verschijnt als het opstarten langer duurt dan een paar tellen. Tot die
                 tijd leeg: wie binnen een seconde binnen is hoeft niet te lezen dat er iets laadt. -->
            <Label x:Name="Wachtregel"
                   FontSize="14"
                   Opacity="0"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
