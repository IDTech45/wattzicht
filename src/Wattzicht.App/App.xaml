<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Wattzicht.App.Converters"
             x:Class="Wattzicht.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBool" />
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmpty" />
            <conv:PowerToKwConverter x:Key="PowerToKw" />
            <conv:BrandToColorConverter x:Key="BrandToColor" />
            <conv:OnlineToColorConverter x:Key="OnlineToColor" />
            <conv:LogoSourceConverter x:Key="LogoSource" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
