<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ Huisstijl: lacivert + geel (skill wattzicht-design). De app draait altijd donker (App.xaml.cs). ============ -->

    <!-- Merk -->
    <Color x:Key="Night">#0A1630</Color>
    <Color x:Key="NightSoft">#12234A</Color>

    <!-- Energiestromen: zon geel, batterij teal, laadpaal oranje (key "Grid"), net/teruglevering paars (key "Export") -->
    <Color x:Key="Sun">#FFE11A</Color>
    <Color x:Key="SunLight">#FFEB66</Color>
    <Color x:Key="Battery">#5EEAD4</Color>
    <Color x:Key="Grid">#FF7A3D</Color>
    <Color x:Key="Export">#B69CFF</Color>

    <!-- Tekst & vlakken (light) -->
    <Color x:Key="Ink">#111827</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="Paper">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Danger">#FF6B6B</Color>

    <!-- Randen en zachte tinten (light) -->
    <Color x:Key="Line">#E2E8F0</Color>
    <Color x:Key="SunSoft">#FEF3C7</Color>
    <Color x:Key="BatterySoft">#DCFCE7</Color>
    <Color x:Key="GridSoft">#DBEAFE</Color>
    <Color x:Key="ExportSoft">#F3E8FF</Color>
    <Color x:Key="DangerSoft">#FEE2E2</Color>

    <!-- ============ Dark-varianten ============ -->
    <Color x:Key="InkDark">#F4F6FB</Color>
    <Color x:Key="MutedDark">#9AA8C4</Color>
    <Color x:Key="PaperDark">#0A1630</Color>
    <Color x:Key="SurfaceDark">#12234A</Color>
    <Color x:Key="DangerDark">#FF6B6B</Color>
    <Color x:Key="LineDark">#22365F</Color>
    <Color x:Key="SunSoftDark">#2E2E1A</Color>
    <Color x:Key="BatterySoftDark">#103A44</Color>
    <Color x:Key="GridSoftDark">#3A2A2E</Color>
    <Color x:Key="ExportSoftDark">#2A2A5A</Color>
    <Color x:Key="DangerSoftDark">#3F1414</Color>

    <!-- Hulpkleuren -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- Brushes voor gradient-accenten -->
    <LinearGradientBrush x:Key="SunGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD166" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NightGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E293B" Offset="0" />
        <GradientStop Color="#0F172A" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
