<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Design-tokens van Wattzicht. Zelfde systeem als LaadCash: zelfde navy, fonts, radius,
        statuskleuren en tekst- en vlakkleuren. Het enige verschil is het accent: LaadCash groen,
        Wattzicht geel. Zie docs/DESIGN-TOKENS.md voor de tabel met beide kolommen.

        Dit is de enige plek in de app waar een kleurcode staat. scripts/check-app-colors.sh
        controleert dat, en controleert ook of elke opgevraagde sleutel hier bestaat: een
        StaticResource die niet bestaat valt in MAUI pas op als het scherm opengaat.
    -->

    <!-- ============ Merk ============ -->
    <Color x:Key="Navy900">#0A2540</Color>
    <Color x:Key="Teal800">#0E3A4A</Color>

    <!-- Accent: geel. Op geel hoort navy-tekst, want geel met wit haalt geen 4,5:1. -->
    <Color x:Key="Accent500">#F5C518</Color>
    <Color x:Key="Accent600">#D9AC0F</Color>
    <Color x:Key="Accent300">#FFE89A</Color>
    <Color x:Key="TextOnAccent">#0A2540</Color>

    <!-- ============ Vlakken (light) ============ -->
    <Color x:Key="BgApp">#F6F8F7</Color>
    <Color x:Key="BgCanvas">#F6F8F7</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Surface2">#EEF2F0</Color>
    <Color x:Key="SurfaceTint">#EEF6F1</Color>
    <Color x:Key="Border">#DFE6E2</Color>
    <Color x:Key="BorderStrong">#C6D1CB</Color>
    <Color x:Key="Divider">#E6EBE8</Color>

    <!-- ============ Tekst ============ -->
    <Color x:Key="TextBody">#36474C</Color>
    <Color x:Key="TextMuted">#5C6B66</Color>
    <Color x:Key="TextFaint">#5F6F75</Color>
    <Color x:Key="TextOnDarkMuted">#9DB4BC</Color>
    <Color x:Key="Placeholder">#AEBAB5</Color>

    <!-- ============ Status ============ -->
    <Color x:Key="SuccessDot">#0E9F6E</Color>
    <Color x:Key="SuccessText">#0E7A55</Color>
    <Color x:Key="SuccessBg">#E6F3EA</Color>

    <Color x:Key="PendingDot">#3B6FE0</Color>
    <Color x:Key="PendingText">#2B59C3</Color>
    <Color x:Key="PendingBg">#EAF0FF</Color>

    <Color x:Key="WarningDot">#E0A82E</Color>
    <Color x:Key="WarningText">#946200</Color>
    <Color x:Key="WarningBg">#FBF1DD</Color>

    <Color x:Key="ErrorDot">#E5484D</Color>
    <Color x:Key="ErrorText">#C2363B</Color>
    <Color x:Key="ErrorBg">#FBE6E7</Color>

    <!--
        ============ Energiekleuren ============
        Gelijk in Wattzicht en LaadCash. Laadpaal is blauw en niet groen, omdat groen in LaadCash het
        merk-accent is; dan zou een laadpaal daar niet van een knop te onderscheiden zijn.
        Deze vijf gelden overal: grafieken, tegels, stroomdiagram en merk-badges.
    -->
    <Color x:Key="EnergySolar">#F5C518</Color>
    <Color x:Key="EnergyBattery">#1FA67A</Color>
    <Color x:Key="EnergyCharger">#3B6FE0</Color>
    <Color x:Key="EnergyGrid">#9DB4BC</Color>
    <Color x:Key="EnergyHome">#36474C</Color>

    <!-- Zachte achtergrond per energiebron, voor badges en tegels. -->
    <Color x:Key="EnergySolarSoft">#FBF1DD</Color>
    <Color x:Key="EnergyBatterySoft">#E6F3EA</Color>
    <Color x:Key="EnergyChargerSoft">#EAF0FF</Color>
    <Color x:Key="EnergyGridSoft">#EEF2F0</Color>

    <!--
        ============ Dark mode ============
        Dezelfde logica als LaadCash: navy wordt de achtergrond in plaats van de tekstkleur.
        Het accent verschuift niet; geel op navy haalt ruim contrast, en een accent dat per thema
        van kleur wisselt maakt een merk onherkenbaar.
    -->
    <Color x:Key="BgAppDark">#0A2540</Color>
    <Color x:Key="BgCanvasDark">#0A2540</Color>
    <Color x:Key="SurfaceDark">#0E3A4A</Color>
    <Color x:Key="Surface2Dark">#123F52</Color>
    <Color x:Key="SurfaceTintDark">#123F52</Color>
    <Color x:Key="BorderDark">#1C4A5C</Color>
    <Color x:Key="BorderStrongDark">#2A5E72</Color>
    <Color x:Key="DividerDark">#1C4A5C</Color>

    <Color x:Key="TextBodyDark">#F0F0F0</Color>
    <Color x:Key="TextMutedDark">#9DB4BC</Color>
    <Color x:Key="TextFaintDark">#9DB4BC</Color>
    <Color x:Key="PlaceholderDark">#7D97A1</Color>

    <!-- Status op donker: de stip blijft, tekst wordt lichter en het vlak donkerder. -->
    <Color x:Key="SuccessTextDark">#5FD3A8</Color>
    <Color x:Key="SuccessBgDark">#0D3D30</Color>
    <Color x:Key="PendingTextDark">#9BB8F5</Color>
    <Color x:Key="PendingBgDark">#13284F</Color>
    <Color x:Key="WarningTextDark">#F3CE7A</Color>
    <Color x:Key="WarningBgDark">#3D3015</Color>
    <Color x:Key="ErrorTextDark">#F79A9D</Color>
    <Color x:Key="ErrorBgDark">#45191B</Color>

    <Color x:Key="EnergyHomeDark">#F0F0F0</Color>
    <Color x:Key="EnergySolarSoftDark">#3D3015</Color>
    <Color x:Key="EnergyBatterySoftDark">#0D3D30</Color>
    <Color x:Key="EnergyChargerSoftDark">#13284F</Color>
    <Color x:Key="EnergyGridSoftDark">#123F52</Color>

    <!-- ============ Hulpkleuren ============ -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

</ResourceDictionary>
