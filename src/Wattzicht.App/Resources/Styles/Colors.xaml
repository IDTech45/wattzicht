<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ Huisstijl-tokens (brand/BRAND.md) ============ -->

    <!-- Merk -->
    <Color x:Key="Night">#0F172A</Color>
    <Color x:Key="NightSoft">#1E293B</Color>

    <!-- Energiestromen: altijd dezelfde kleur in app én site -->
    <Color x:Key="Sun">#F59E0B</Color>
    <Color x:Key="SunLight">#FFD166</Color>
    <Color x:Key="Battery">#22C55E</Color>
    <Color x:Key="Grid">#3B82F6</Color>
    <Color x:Key="Export">#A855F7</Color>

    <!-- Tekst & vlakken (light) -->
    <Color x:Key="Ink">#111827</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="Paper">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Danger">#DC2626</Color>

    <!-- Randen en zachte tinten (light) -->
    <Color x:Key="Line">#E2E8F0</Color>
    <Color x:Key="SunSoft">#FEF3C7</Color>
    <Color x:Key="BatterySoft">#DCFCE7</Color>
    <Color x:Key="GridSoft">#DBEAFE</Color>
    <Color x:Key="ExportSoft">#F3E8FF</Color>
    <Color x:Key="DangerSoft">#FEE2E2</Color>

    <!-- ============ Dark-varianten ============ -->
    <Color x:Key="InkDark">#F8FAFC</Color>
    <Color x:Key="MutedDark">#94A3B8</Color>
    <Color x:Key="PaperDark">#0F172A</Color>
    <Color x:Key="SurfaceDark">#1E293B</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="LineDark">#334155</Color>
    <Color x:Key="SunSoftDark">#3B2F0B</Color>
    <Color x:Key="BatterySoftDark">#0F2F1C</Color>
    <Color x:Key="GridSoftDark">#122A4D</Color>
    <Color x:Key="ExportSoftDark">#2E1A4D</Color>
    <Color x:Key="DangerSoftDark">#3F1414</Color>

    <!-- Hulpkleuren -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- Brushes voor gradient-accenten -->
    <LinearGradientBrush x:Key="SunGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD166" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NightGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E293B" Offset="0" />
        <GradientStop Color="#0F172A" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
