<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
    <!-- CI op Linux: alleen Android bouwen (dotnet build -p:AndroidOnly=true) -->
    <TargetFrameworks Condition="'$(AndroidOnly)' == 'true'">net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Wattzicht.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- App -->
    <ApplicationTitle>Wattzicht</ApplicationTitle>
    <ApplicationId>nl.wattzicht.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App-icoon: achtergrond + voorgrond (adaptive icon op Android) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F172A" />

    <!-- Splash -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F172A" BaseSize="160,160" />

    <!-- Afbeeldingen (SVG's worden naar PNG omgezet per dichtheid) -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\home.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\devices.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\savings.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\settings.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\sturen.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\logo.svg" BaseSize="96,96" />

    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- Pushmeldingen (Android): Firebase Cloud Messaging -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.1.0.1" />
    <!-- Optioneel: zet google-services.json uit de Firebase-console hier neer; dan start Firebase vanzelf. -->
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wattzicht.Shared\Wattzicht.Shared.csproj" />
  </ItemGroup>

  <!-- Android: network_security_config per configuratie (HTTP naar emulator-host alleen in Debug) -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidResource Include="Platforms\Android\NetworkSecurity\debug\network_security_config.xml"
                     Condition="'$(Configuration)' == 'Debug'"
                     Link="Resources\xml\network_security_config.xml"
                     LogicalName="xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\NetworkSecurity\release\network_security_config.xml"
                     Condition="'$(Configuration)' != 'Debug'"
                     Link="Resources\xml\network_security_config.xml"
                     LogicalName="xml\network_security_config.xml" />
    <None Remove="Platforms\Android\NetworkSecurity\**" />
  </ItemGroup>

  <!-- iOS: Info.Debug.plist bevat de ATS-uitzondering voor localhost; release gebruikt Info.plist -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <None Remove="Platforms\iOS\Info.Debug.plist" />
    <PartialAppManifest Include="Platforms\iOS\Info.Debug.plist" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
