<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Wattzicht.App.Pages"
       x:Class="Wattzicht.App.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Teal800}}"
       Shell.ForegroundColor="{AppThemeBinding Light={StaticResource TextBody}, Dark={StaticResource TextBodyDark}}"
       Shell.TitleColor="{AppThemeBinding Light={StaticResource TextBody}, Dark={StaticResource TextBodyDark}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Teal800}}"
       Shell.TabBarForegroundColor="{StaticResource Accent500}"
       Shell.TabBarTitleColor="{StaticResource Accent500}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}">

    <!-- Login staat buiten de tabs: geen TabBar zichtbaar -->
    <ShellContent Route="login"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate pages:LoginPage}" />

    <TabBar Route="main">
        <Tab Title="Home" Icon="home.png" Route="home">
            <ShellContent ContentTemplate="{DataTemplate pages:DashboardPage}" />
        </Tab>
        <Tab Title="Sturen" Icon="sturen.png" Route="advice">
            <ShellContent ContentTemplate="{DataTemplate pages:AdvicePage}" />
        </Tab>
        <Tab Title="Apparaten" Icon="devices.png" Route="devices">
            <ShellContent ContentTemplate="{DataTemplate pages:DevicesPage}" />
        </Tab>
        <Tab Title="Besparing" Icon="savings.png" Route="savings">
            <ShellContent ContentTemplate="{DataTemplate pages:SavingsPage}" />
        </Tab>
        <Tab Title="Instellingen" Icon="settings.png" Route="settings">
            <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
