<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Wattzicht.App.Pages"
       x:Class="Wattzicht.App.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Teal800}}"
       Shell.ForegroundColor="{AppThemeBinding Light={StaticResource TextBody}, Dark={StaticResource TextBodyDark}}"
       Shell.TitleColor="{AppThemeBinding Light={StaticResource TextBody}, Dark={StaticResource TextBodyDark}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Teal800}}"
       BackgroundColor="{AppThemeBinding Light={StaticResource BgApp}, Dark={StaticResource Navy900}}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}"
       Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Navy900}, Dark={StaticResource Accent500}}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Navy600}, Dark={StaticResource TextMutedDark}}">

    <!-- Login staat buiten de tabs: geen TabBar zichtbaar -->
    <ShellContent Route="login"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate pages:LoginPage}" />

    <!--
        Geen navigatiebalk boven de tabbladen. Elke pagina zet zijn eigen titel in beeld, dus die
        balk herhaalde alleen wat er een regel lager al stond en liet verder een witte strook over.
        Zonder die balk is er ook meer ruimte voor de inhoud zelf.

        De titels van de tabs zijn kort gehouden. "Instellingen" en "Besparing" pasten op een smal
        toestel niet en werden afgekapt tot iets onleesbaars; vijf tabs naast elkaar laten maar een
        woord of acht toe.
    -->
    <TabBar Route="main">
        <Tab Title="Home" Icon="home.png" Route="home">
            <ShellContent Shell.NavBarIsVisible="False" ContentTemplate="{DataTemplate pages:DashboardPage}" />
        </Tab>
        <Tab Title="Sturen" Icon="sturen.png" Route="advice">
            <ShellContent Shell.NavBarIsVisible="False" ContentTemplate="{DataTemplate pages:AdvicePage}" />
        </Tab>
        <Tab Title="Apparaten" Icon="devices.png" Route="devices">
            <ShellContent Shell.NavBarIsVisible="False" ContentTemplate="{DataTemplate pages:DevicesPage}" />
        </Tab>
        <Tab Title="Besparen" Icon="savings.png" Route="savings">
            <ShellContent Shell.NavBarIsVisible="False" ContentTemplate="{DataTemplate pages:SavingsPage}" />
        </Tab>
        <Tab Title="Meer" Icon="settings.png" Route="settings">
            <ShellContent Shell.NavBarIsVisible="False" ContentTemplate="{DataTemplate pages:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
