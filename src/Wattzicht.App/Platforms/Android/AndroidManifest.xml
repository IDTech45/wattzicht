<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Zonder deze regel staat er in het uiteindelijke pakket geen doel-API, en dan weigert Google Play
    het met "Target SDK of artifact is too low: 1". Het bouwen zelf gaat wel goed, dus je merkt het
    pas bij de upload; op 12-11-2026 liep de eerste release daarop stuk nadat alles al gelukt was.
    Daarom staat het hier expliciet in plaats van dat we erop vertrouwen dat de build het invult.
    Met 35 weigerde Play het nog steeds. Sinds eind augustus 2026 moet een nieuwe app API 36 halen,
    en LaadCash staat ook op 36. Play leest alleen deze waarde uit het pakket, dus die zetten we hier
    op 36; .NET 9 bouwt nog tegen 35. Dat betekent dat gedragswijzigingen van Android 16 gelden
    zonder dat we ertegen gebouwd hebben, en dat is voor een interne test prima maar geen eindstand:
    zodra de android-workload 36 meelevert hoort het project daar gewoon tegen te bouwen.
    24 is Android 7, de ondergrens die ook in het projectbestand staat.
  -->
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
  <!--
    Cleartext (HTTP) staat standaard uit. Het csproj koppelt per configuratie een
    network_security_config: DEBUG staat HTTP toe naar 10.0.2.2/localhost (emulator -> host),
    RELEASE blokkeert alles behalve HTTPS. Zie Platforms/Android/NetworkSecurity/.
  -->
  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true"
               android:label="Wattzicht"
               android:networkSecurityConfig="@xml/network_security_config">
    <!-- Pushmeldingen op de achtergrond: wit silhouet-icoon en ons kanaal -->
    <meta-data android:name="com.google.firebase.messaging.default_notification_icon"
               android:resource="@drawable/ic_stat_wattzicht" />
    <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id"
               android:value="wattzicht" />
  </application>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Android 13+: toestemming voor pushmeldingen -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
