<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Cleartext (HTTP) staat standaard uit. Het csproj koppelt per configuratie een
    network_security_config: DEBUG staat HTTP toe naar 10.0.2.2/localhost (emulator -> host),
    RELEASE blokkeert alles behalve HTTPS. Zie Platforms/Android/NetworkSecurity/.
  -->
  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true"
               android:label="Wattzicht"
               android:networkSecurityConfig="@xml/network_security_config" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Android 13+: toestemming voor pushmeldingen -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
